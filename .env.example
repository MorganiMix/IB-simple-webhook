# Trading Bot Configuration

# Stock/Contract Settings
EXCHANGE=SMART
INSTRUMENT=AAPL
ORDER_SIZE=1
# SEC_TYPE: STK for stocks, FUT for futures
SEC_TYPE=STK
# For futures: YYYYMM (e.g. 202609) or 'auto' for front month
CONTRACT_MONTH=auto
# Currency: empty = auto-detect from exchange (USD for NYMEX/CME/COMEX, EUR for EUREX, HKD for HKFE)
CURRENCY=

# For Hong Kong stocks, use:
# INSTRUMENT=2800
# ORDER_SIZE=500

# For futures, examples:
# MCL (Micro WTI Crude Oil):
#   EXCHANGE=NYMEX
#   INSTRUMENT=MCL
#   SEC_TYPE=FUT
#   CONTRACT_MONTH=auto
#
# DAX (German DAX Index Future):
#   EXCHANGE=EUREX
#   INSTRUMENT=DAX
#   SEC_TYPE=FUT
#
# MGC (Micro Gold):
#   EXCHANGE=COMEX
#   INSTRUMENT=MGC
#   SEC_TYPE=FUT
#
# MNQ (Micro E-mini Nasdaq):
#   EXCHANGE=CME
#   INSTRUMENT=MNQ
#   SEC_TYPE=FUT
#
# HSI (Hang Seng Index Future):
#   EXCHANGE=HKFE
#   INSTRUMENT=MHI
#   SEC_TYPE=FUT

# Interactive Brokers Connection
IB_HOST=127.0.0.1
IB_PORT=4002
CLIENT_ID=130

# Bot Settings
RETRY_INTERVAL=30
WEBHOOK_PORT=8001
WEBHOOK_PATH=/webhook

# Security Settings
ENABLE_SECURITY_FILTER=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Common IB Port Settings:
# IB Gateway Paper Trading: 4002
# IB Gateway Live Trading: 4001
# TWS Paper Trading: 7496
# TWS Live Trading: 7497